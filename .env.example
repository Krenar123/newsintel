# Database
#DATABASE_URL=postgresql://newsintel:replace-with-strong-password@localhost:5432/newsintel
DATABASE_URL=sqlite:///data/newsintel.db
# Claude API (optional — only needed for premium abstractive summaries)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
ENABLE_AI_INTELLIGENCE=false
AI_GROUNDING_REQUIRED=true
ANTHROPIC_API_KEY=

# Email delivery (optional — only needed for email reports)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=reports@yourdomain.com

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_COUNTRY=mk
ENABLE_AI_SUMMARIES=false
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
TOKEN_EXPIRY_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
SEED_ADMIN_EMAIL=admin@newsintel.local
SEED_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Ingestion settings
INGESTION_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_FEED=50
ARTICLE_RETENTION_DAYS=90
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v24.0
MAX_FACEBOOK_POSTS_PER_PAGE=25

# Rate limiting
SCRAPE_DELAY_SECONDS=2
MAX_CONCURRENT_REQUESTS=5

# Production operations
BACKUP_DIR=data/backups
REPORTS_DIR=reports
SCHEDULER_NO_EMAIL=true

# NewsIntel production environment template
# Copy to .env.production or to your cloud provider secret store.

APP_ENV=production
LOG_LEVEL=INFO
DEFAULT_COUNTRY=mk

# Public URLs
# Use exact domains. Do not use wildcard CORS in production.
PUBLIC_FRONTEND_URL=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# Database
POSTGRES_USER=newsintel
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=newsintel
DATABASE_URL=postgresql://newsintel:replace-with-strong-random-password@db:5432/newsintel

# API/runtime
API_WORKERS=2
API_PUBLIC_PORT=8000
FRONTEND_PUBLIC_PORT=80
TOKEN_EXPIRY_HOURS=12
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=replace-with-long-random-admin-password

# Ingestion
INGESTION_INTERVAL_MINUTES=15
STOP_AFTER_CONSECUTIVE_DUPLICATES=10
MAX_ARTICLES_PER_FEED=50
SCHEDULER_MAX_ARTICLES_PER_SOURCE=20
SCRAPE_DELAY_SECONDS=2
SCHEDULER_NO_EMAIL=true

# AI is optional. Keep disabled until product/legal guardrails are reviewed.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
ENABLE_AI_INTELLIGENCE=false
ENABLE_AI_SUMMARIES=false
AI_GROUNDING_REQUIRED=true
ANTHROPIC_API_KEY=

# Email delivery. Leave blank until SMTP is tested.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=reports@yourdomain.com

# Social ingestion parked for now.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v24.0
MAX_FACEBOOK_POSTS_PER_PAGE=25

# Cloud backup/storage notes:
# - DB backups should run daily using scripts/backup_database.py or provider snapshots.
# - Store generated reports and DB backups in persistent volumes or object storage.
